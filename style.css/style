* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: #f8f9fb;
    color: #15171a;
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}


/* ================= NAVBAR ================= */

.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;

    background: rgba(248, 249, 251, 0.88);
    backdrop-filter: blur(14px);

    border-bottom: 1px solid #e5e7eb;
}

.nav-container {
    max-width: 1180px;
    margin: auto;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 25px;
}

.logo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: #2563eb;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-size: 14px;
    font-weight: 500;
    color: #555;
    transition: 0.2s;
}

nav a:hover {
    color: #2563eb;
}


/* ================= HERO ================= */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;

    padding: 120px 25px 80px;
}

.hero-content {
    width: 100%;
    max-width: 1180px;
    margin: auto;

    display: grid;
    grid-template-columns: 1.25fr 0.75fr;

    gap: 80px;
    align-items: center;
}

.eyebrow {
    color: #2563eb;
    font-size: 14px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 2px;

    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(52px, 7vw, 88px);
    line-height: 1;
    letter-spacing: -4px;

    margin-bottom: 30px;
}

.hero h1 span {
    color: #2563eb;
}

.hero-description {
    max-width: 650px;

    font-size: 18px;
    color: #5d6470;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 13px 22px;

    border-radius: 8px;

    font-weight: 600;
    font-size: 14px;

    transition: 0.25s;
}

.btn.primary {
    background: #15171a;
    color: white;
}

.btn.primary:hover {
    background: #2563eb;
    transform: translateY(-2px);
}

.btn.secondary {
    border: 1px solid #d6d9de;
}

.btn.secondary:hover {
    border-color: #2563eb;
    color: #2563eb;
}

.social-links {
    display: flex;
    gap: 20px;

    margin-top: 30px;

    font-size: 14px;
    font-weight: 500;
}

.social-links a:hover {
    color: #2563eb;
}


/* ================= IMAGE ================= */

.hero-image {
    display: flex;
    justify-content: center;
}

.image-wrapper {
    width: 340px;
    height: 420px;

    border-radius: 18px;

    overflow: hidden;

    border: 1px solid #ddd;

    box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.12);
}

.image-wrapper img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}


/* ================= SECTIONS ================= */

.section {
    max-width: 1180px;
    margin: auto;

    padding: 120px 25px;
}

.section-header {
    margin-bottom: 55px;
}

.section-number {
    color: #2563eb;

    font-size: 13px;
    font-weight: 700;

    letter-spacing: 2px;

    margin-bottom: 8px;
}

.section h2 {
    font-size: 46px;
    letter-spacing: -2px;
}


/* ================= ABOUT ================= */

.about-content {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;

    gap: 70px;
}

.about-content p {
    color: #5d6470;
    font-size: 17px;

    margin-bottom: 20px;
}

.about-card {
    background: white;

    padding: 30px;

    border: 1px solid #e4e7eb;
    border-radius: 14px;
}

.about-card h3 {
    margin-bottom: 20px;
}

.about-card ul {
    list-style: none;
}

.about-card li {
    padding: 9px 0;

    border-bottom: 1px solid #eee;

    font-size: 14px;
}


/* ================= RESEARCH ================= */

.research-section {
    max-width: none;

    background: #15171a;
    color: white;

    padding-left: max(25px, calc((100% - 1130px) / 2));
    padding-right: max(25px, calc((100% - 1130px) / 2));
}

.research-section .section-number {
    color: #60a5fa;
}

.section-intro {
    max-width: 700px;

    color: #a9afb8;

    font-size: 18px;

    margin-bottom: 50px;
}

.research-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.research-card {
    border: 1px solid #34373c;

    padding: 35px;

    border-radius: 12px;

    transition: 0.3s;
}

.research-card:hover {
    transform: translateY(-6px);
    border-color: #60a5fa;
}

.card-number {
    color: #60a5fa;

    font-size: 13px;

    margin-bottom: 45px;
}

.research-card h3 {
    font-size: 22px;

    margin-bottom: 15px;
}

.research-card p {
    color: #a9afb8;

    font-size: 14px;
}


/* ================= PUBLICATIONS ================= */

.publication {
    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 30px;

    padding: 35px 0;

    border-top: 1px solid #ddd;
}

.publication-year {
    color: #2563eb;

    font-weight: 700;
}

.publication h3 {
    font-size: 22px;

    max-width: 800px;

    margin-bottom: 10px;
}

.authors {
    color: #555;

    margin-bottom: 5px;
}

.venue {
    color: #777;

    font-size: 14px;
}

.publication-links {
    display: flex;

    gap: 20px;

    margin-top: 15px;
}

.publication-links a {
    color: #2563eb;

    font-size: 14px;

    font-weight: 600;
}


/* ================= PROJECTS ================= */

.projects-section {
    background: #f1f3f6;

    max-width: none;

    padding-left: max(25px, calc((100% - 1130px) / 2));
    padding-right: max(25px, calc((100% - 1130px) / 2));
}

.project-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.project-card {
    background: white;

    padding: 30px;

    border-radius: 12px;

    border: 1px solid #e2e5e9;

    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-6px);

    box-shadow:
        0 15px 35px rgba(0, 0, 0, 0.08);
}

.project-top {
    display: flex;

    justify-content: space-between;

    color: #2563eb;

    margin-bottom: 40px;
}

.project-card h3 {
    font-size: 22px;

    margin-bottom: 12px;
}

.project-card p {
    color: #666;

    font-size: 14px;

    margin-bottom: 25px;
}

.tags {
    display: flex;

    gap: 7px;

    flex-wrap: wrap;
}

.tags span {
    background: #eef2ff;

    color: #3451b2;

    font-size: 11px;

    padding: 5px 9px;

    border-radius: 5px;
}


/* ================= EDUCATION ================= */

.timeline {
    border-left: 2px solid #ddd;

    padding-left: 35px;
}

.timeline-item {
    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 20px;

    padding-bottom: 45px;
}

.timeline-date {
    color: #2563eb;

    font-weight: 700;
}

.timeline-item h3 {
    font-size: 21px;
}

.timeline-item p {
    color: #666;
}


/* ================= CONTACT ================= */

.contact-section {
    background: #15171a;

    color: white;

    text-align: center;

    padding: 120px 25px;
}

.contact-container {
    max-width: 750px;

    margin: auto;
}

.contact-section .section-number {
    color: #60a5fa;
}

.contact-section h2 {
    font-size: clamp(45px, 7vw, 75px);

    letter-spacing: -3px;

    margin-bottom: 20px;
}

.contact-section p {
    color: #a9afb8;

    margin-bottom: 25px;
}

.email {
    display: inline-block;

    font-size: 18px;

    color: #60a5fa;

    font-weight: 600;

    margin-bottom: 30px;
}

.contact-links {
    display: flex;

    justify-content: center;

    gap: 25px;

    font-size: 14px;
}

.contact-links a:hover {
    color: #60a5fa;
}


/* ================= FOOTER ================= */

footer {
    background: #0d0e10;

    color: #777;

    text-align: center;

    padding: 25px;

    font-size: 12px;
}


/* ================= MOBILE ================= */

@media (max-width: 800px) {

    nav {
        display: none;
    }

    .hero-content {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .hero-image {
        order: -1;
    }

    .image-wrapper {
        width: 260px;
        height: 320px;
    }

    .hero h1 {
        font-size: 55px;

        letter-spacing: -3px;
    }

    .about-content {
        grid-template-columns: 1fr;
    }

    .research-grid,
    .project-grid {
        grid-template-columns: 1fr;
    }

    .publication {
        grid-template-columns: 1fr;

        gap: 10px;
    }

    .timeline-item {
        grid-template-columns: 1fr;
    }

}
